# ==============================================================================
# DigiVentures .gitignore
# ==============================================================================

# Operating System & Filesystem
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
ehthumbs_vista.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
.directory
*~
*.swp
*.swo

# IDE & Editor Files
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.code-workspace
.project
.settings/
.buildpath

# Environment & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs & Debugging
# ------------------------------------------------------------------------------
*.log
debug.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node & Frontend Build (Vite / Tailwind / PostCSS)
# ------------------------------------------------------------------------------
node_modules/
dist/
build/
.vite/
.turbo/
.parcel-cache/
.next/
.nuxt/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Package Manager Storage
# ------------------------------------------------------------------------------
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Database dumps & Local SQL exports (except drizzle migrations)
# ------------------------------------------------------------------------------
*.sql
!db/migrations/*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.db

# Temporary & Local Uploads
# ------------------------------------------------------------------------------
tmp/
temp/
.temp/
storage/uploads/


