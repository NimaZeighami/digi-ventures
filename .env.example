# App Configuration
NODE_ENV=production
APP_URL=https://digiventures.ir
PORT=3000

# Database (PostgreSQL 16+)
DATABASE_URL=postgres://dv_user:secret_password@localhost:5432/digiventures_db

# Authentication
SESSION_SECRET=super_secret_64_byte_random_string_here

# Storage
STORAGE_ROOT=/var/app/storage/uploads/pitch-decks

# Transactional SMTP
SMTP_HOST=smtp.relay.ir
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@digiventures.ir
SMTP_PASSWORD=secret_smtp_password
SMTP_FROM='"Digi Ventures" <noreply@digiventures.ir>'

# Notifications
ADMIN_NOTIFICATION_EMAIL=investment@digiventures.ir
