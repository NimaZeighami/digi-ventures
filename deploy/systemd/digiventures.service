[Unit]
Description=Digi Ventures Next.js Standalone Application
After=network.target postgresql.service

[Service]
Type=simple
User=dvapp
Group=dvapp
WorkingDirectory=/var/app/digiventures
EnvironmentFile=/var/app/digiventures/.env
ExecStart=/usr/bin/node /var/app/digiventures/server.js
Restart=always
RestartSec=5

# Sandboxing and security
ProtectSystem=full
NoNewPrivileges=true
PrivateTmp=true
LimitNOFILE=65535

# Resource limits
MemoryMax=1G
CPUQuota=200%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=digiventures-app

[Install]
WantedBy=multi-user.target
